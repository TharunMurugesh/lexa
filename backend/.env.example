# LEXA Environment Configuration
# Copy this file to .env and fill in your values

# ===== API Configuration =====
DEBUG=false
HOST=localhost
PORT=8000
RELOAD=true

# ===== LLM Configuration (Ollama) =====
# For local Ollama: http://localhost:11434
# For remote: adjust accordingly
MODEL_NAME=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE_REASONING=0.1
LLM_TEMPERATURE_CREATIVE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# ===== Embedding Configuration =====
# BGE Large is recommended for dense retrieval in legal domain
EMBEDDING_MODEL=sentence-transformers/bge-large-en-v1.5
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# ===== Retrieval Configuration =====
FAISS_INDEX_PATH=models/faiss_indices/v1/index.bin
FAISS_METADATA_PATH=models/faiss_indices/v1/metadata.pkl
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX_NAME=legal_corpus
RETRIEVAL_TOP_K_SPARSE=20
RETRIEVAL_TOP_K_DENSE=20
RETRIEVAL_TOP_K_RERANKED=5

# Cross-encoder reranker model
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2

# ===== NLI Configuration =====
# For contradiction detection
NLI_MODEL=cross-encoder/nli-deberta-v3-large
CONTRADICTION_THRESHOLD=0.7

# ===== Document Processing =====
MAX_DOCUMENT_SIZE_MB=50
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=128
MIN_CHUNK_SIZE_TOKENS=100

# ===== Debate Configuration =====
MAX_DEBATE_ROUNDS=3
CONFIDENCE_THRESHOLD=0.6
CONTRADICTION_SEVERITY_THRESHOLD=0.7

# ===== Async Task Configuration (Celery + Redis) =====
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_TIMEOUT=300

# ===== MLflow Configuration =====
# MLflow tracking server for experiment management
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=lexa_experiments
MLFLOW_REGISTRY_URI=

# ===== DVC Configuration =====
# DVC remote for data versioning (local storage for development)
DVC_REMOTE_URL=./dvc-storage

# ===== Directory Paths =====
DATA_DIR=data
CORPUS_DIR=data/corpus
TRAINING_DIR=data/training
EVAL_DIR=data/evaluation
MODELS_DIR=models
LOGS_DIR=logs
PROMPTS_DIR=backend/config/prompts

# ===== Evaluation Configuration =====
EVAL_SET_SIZE=100
EVAL_SAMPLE_SIZE=20

# ===== Security & Monitoring =====
API_KEY_OPTIONAL=true
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=logs/audit.log

# ===== GPU/Hardware Configuration =====
GPU_MEMORY_FRACTION=0.85
USE_GPU=true
DEVICE=cuda
